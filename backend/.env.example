# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=taskmaster

# JWT — generate with: openssl rand -base64 48
# This maps to appsettings.json "Jwt:Key" via ASP.NET Core env-var override (__ = :)
Jwt__Key=CHANGE_ME_generate_with_openssl_rand_base64_48

# SMTP Configuration (for email notifications)
# For Gmail: enable 2FA then generate an App Password at https://myaccount.google.com/apppasswords
EmailSettings__Username=your-email@gmail.com
EmailSettings__Password=your-gmail-app-password

# CORS (comma-separated list of allowed frontend origins)
Cors__AllowedOrigins=http://localhost:3000
